---
export interface Props {
  title: string;
  description: string;
  href?: string;
  tags?: string[];
  language?: string;
}

const { href, title, description, tags = [], language } = Astro.props;

const langColors: Record<string, { bg: string; border: string; text: string }> = {
  Java: { bg: "rgba(244, 128, 36, 0.1)", border: "rgba(244, 128, 36, 0.3)", text: "#f48024" },
  "C#": { bg: "rgba(104, 33, 122, 0.15)", border: "rgba(155, 89, 182, 0.3)", text: "#9b59b6" },
  TypeScript: { bg: "rgba(49, 120, 198, 0.1)", border: "rgba(49, 120, 198, 0.3)", text: "#3178c6" },
  Angular: { bg: "rgba(221, 0, 49, 0.1)", border: "rgba(221, 0, 49, 0.3)", text: "#dd0031" },
};

const langStyle = language && langColors[language] ? langColors[language] : null;
---

<li class="project-card">
  <a href={href || "#"} target={href ? "_blank" : undefined} rel={href ? "noopener" : undefined}>
    {language && langStyle && (
      <span class="lang-badge" style={`background:${langStyle.bg};border-color:${langStyle.border};color:${langStyle.text}`}>
        {language}
      </span>
    )}
    <h3>{title}</h3>
    <p>{description}</p>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )}
  </a>
</li>

<style>
  .project-card {
    list-style: none;
  }

  .project-card > a {
    display: block;
    background: linear-gradient(135deg, #0f0f18, #1a1a28);
    border: 1px solid #1e1e2e;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .project-card > a:hover {
    border-color: #d4a57444;
    transform: translateY(-2px);
  }

  .lang-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #f0f0f0;
    margin: 0 0 0.5rem;
  }

  p {
    color: #9ca3af;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    background: rgba(212, 165, 116, 0.08);
    border: 1px solid rgba(212, 165, 116, 0.2);
    color: #d4a574;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
  }
</style>

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home | Portfolio">
  <main>
    <section class="hero">
      <p class="greeting">Hi, I'm</p>
      <h1>Alex Developer</h1>
      <p class="tagline">
        A web developer who builds fast, accessible, and thoughtful websites.
      </p>
      <div class="cta">
        <a href="/projects" class="btn btn-primary">View Projects</a>
        <a href="/about" class="btn btn-secondary">About Me</a>
      </div>
    </section>

    <section class="highlights">
      <div class="highlight-card">
        <h3>Clean Code</h3>
        <p>Writing maintainable, well-structured code that stands the test of time.</p>
      </div>
      <div class="highlight-card">
        <h3>Fast Sites</h3>
        <p>Performance-first approach with static generation and minimal JavaScript.</p>
      </div>
      <div class="highlight-card">
        <h3>Modern Stack</h3>
        <p>Using tools like Astro, TypeScript, and modern CSS to build great experiences.</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .greeting {
    font-size: 1.1rem;
    color: #9ca3af;
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    margin: 0 0 1rem;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 1.2rem;
    color: #9ca3af;
    max-width: 500px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .btn:hover {
    opacity: 0.85;
  }

  .btn-primary {
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    color: #0c0c0c;
  }

  .btn-secondary {
    border: 1px solid #374151;
    color: #e5e7eb;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .highlight-card {
    background: linear-gradient(135deg, rgba(21, 23, 24, 1), rgba(38, 41, 43, 1));
    border: 1px solid #1f2937;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .highlight-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: #f0f0f0;
  }

  .highlight-card p {
    margin: 0;
    color: #9ca3af;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2rem;
    }

    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>

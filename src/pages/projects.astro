---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

const projects = [
  {
    title: "Cave Graph Traversal",
    description: "BFS and DFS algorithms to explore interconnected cave chambers and find optimal paths through underground networks.",
    tags: ["Graphs", "BFS", "DFS", "Pathfinding"],
    language: "Java",
  },
  {
    title: "Cave System Modeler",
    description: "Object-oriented model of cave systems with chambers, passages, stalactites, stalagmites, and geological properties.",
    tags: ["OOP", "Geology", "Modeling"],
    language: "C#",
  },
  {
    title: "Cave Mapper",
    description: "Type-safe coordinate mapping system for plotting cave surveys with distance and bearing calculations.",
    tags: ["Geometry", "Mapping", "Coordinates"],
    language: "TypeScript",
  },
  {
    title: "Cave Dashboard",
    description: "Angular components for displaying cave exploration stats, environmental readings, and expedition logs.",
    tags: ["Components", "Services", "Dashboard"],
    language: "Angular",
  },
  {
    title: "Speleothem Classifier",
    description: "Classification system for cave formations using enum-based type hierarchies and pattern matching.",
    tags: ["Enums", "Classification", "Patterns"],
    language: "Java",
  },
  {
    title: "Underground River Simulator",
    description: "Simulation of underground water flow through cave passages with erosion and mineral deposit tracking.",
    tags: ["Simulation", "Hydrology", "Events"],
    language: "C#",
  },
];
---

<Layout title="Projects | CaveExplorer">
  <main>
    <h1>Projects</h1>
    <p class="subtitle">Cave exploration tools built with Java, C#, TypeScript, and Angular.</p>

    <ul class="project-grid">
      {projects.map((project) => (
        <Card
          title={project.title}
          description={project.description}
          tags={project.tags}
          language={project.language}
        />
      ))}
    </ul>
  </main>
</Layout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 2rem 0 0.5rem;
  }

  .subtitle {
    color: #9ca3af;
    font-size: 1.1rem;
    margin: 0 0 2rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";

const projects = [
  {
    title: "Task Tracker",
    description: "A productivity app for managing tasks with drag-and-drop, labels, and due dates. Built with React and a Node.js backend.",
    tags: ["React", "Node.js", "PostgreSQL"],
    link: "#",
  },
  {
    title: "Weather Dashboard",
    description: "A real-time weather dashboard that shows forecasts, maps, and alerts. Uses a public weather API and geolocation.",
    tags: ["TypeScript", "Astro", "API"],
    link: "#",
  },
  {
    title: "Dev Blog",
    description: "A personal blog built with Astro and Markdown. Features syntax highlighting, RSS feed, and dark mode.",
    tags: ["Astro", "Markdown", "CSS"],
    link: "#",
  },
  {
    title: "Chat App",
    description: "A real-time messaging application with rooms, typing indicators, and message history. Uses WebSockets.",
    tags: ["React", "Socket.io", "Express"],
    link: "#",
  },
  {
    title: "CLI Tool",
    description: "A command-line utility for scaffolding new projects with customizable templates and configuration.",
    tags: ["Node.js", "TypeScript", "CLI"],
    link: "#",
  },
  {
    title: "Portfolio Site",
    description: "This portfolio website, built with Astro. Statically generated for fast loading and deployed on Fleek.",
    tags: ["Astro", "TypeScript", "Fleek"],
    link: "#",
  },
];
---

<Layout title="Projects | Portfolio">
  <Nav slot="nav" />
  <main>
    <h1>Projects</h1>
    <p class="subtitle">A selection of things I've built.</p>
    <div class="project-grid">
      {projects.map((project) => (
        <div class="project-card">
          <h3><a href={project.link}>{project.title}</a></h3>
          <p>{project.description}</p>
          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </main>
  <Footer slot="footer" />
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  h1 {
    font-size: 2.25rem;
    color: #fff;
    margin: 3rem 0 0.5rem;
  }

  .subtitle {
    color: #9ca3af;
    font-size: 1.1rem;
    margin: 0 0 2rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding-bottom: 4rem;
  }

  .project-card {
    border: 1px solid #1f2937;
    border-radius: 12px;
    padding: 1.5rem;
    background: #161616;
    transition: border-color 0.2s;
  }

  .project-card:hover {
    border-color: #374151;
  }

  .project-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  .project-card h3 a {
    color: #fff;
    text-decoration: none;
  }

  .project-card h3 a:hover {
    color: #60a5fa;
  }

  .project-card p {
    color: #9ca3af;
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: #1f2937;
    color: #9ca3af;
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
